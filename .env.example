# Firebase (Student Auth — Email/Password)
# Enable Email/Password sign-in in Firebase Console → Authentication → Sign-in method
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Supabase (Teacher Auth via OTP + all data storage)
# Get these from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local safety switches. Keep both false in production.
# Set both true in .env.local to inspect live data without enabling writes.
VITE_READ_ONLY_MODE=false
VITE_LOCAL_DATA_PREVIEW=false

# Gmail SMTP (submission and review notifications)
# Server-side aliases can be set separately; the API falls back to VITE_*.
FIREBASE_API_KEY=your_firebase_api_key
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
GMAIL_USER=noreply.rileadership@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
NOTIFICATION_FROM_EMAIL=Leadership Programme <noreply.rileadership@gmail.com>
